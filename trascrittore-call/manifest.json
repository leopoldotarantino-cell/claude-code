{
  "manifest_version": 3,
  "name": "Trascrittore Call",
  "version": "1.0",
  "description": "Trascrive in tempo reale le call (Meet, Teams, Zoom web…) separando le voci e genera il recap.",
  "permissions": ["tabCapture", "activeTab", "storage"],
  "host_permissions": ["https://api.groq.com/*"],
  "action": { "default_title": "Avvia trascrizione di questa scheda" },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html"
}
